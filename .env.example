API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional: require this key as X-API-Key on /v1 requests.
API_ACCESS_KEY=
# Defaults to the locally captured file. Never put upstream credentials in frontend code.
# PALLIUM_AUTH_FILE=/absolute/path/to/transport-auth.json
# Or provide the complete header value, including the Basic prefix:
# PALLIUM_AUTHORIZATION=Basic ...
# Çevrimdışı model toplayıcısı (kapalı gelir). Açmak için 1 yapıp servisi yeniden başlatın.
COLLECTOR_ENABLED=0
# Araçlı hat yönü sorgu aralığı (sn, en az 120) ve araçsız hat yönü aralığı (sn)
# COLLECTOR_ACTIVE_SECONDS=240
# COLLECTOR_IDLE_SECONDS=600
# Aynı anda en çok kaç sağlayıcı isteği (1-3; sağlayıcının 4 yuvasından en az biri kullanıcılara kalır)
# COLLECTOR_CONCURRENCY=2
# Tampon yazma aralığı (sn), ham veri saklama (gün), toplama penceresi (yerel saat)
# COLLECTOR_FLUSH_SECONDS=300
# COLLECTOR_RETENTION_DAYS=60
# COLLECTOR_WINDOW_START=05:30
# COLLECTOR_WINDOW_END=00:30
# Veri dizini (ham kayıt, statik girdi, model). Vekil modeli her zaman <repo>/data altından sunar.
# MARAS_DATA_DIR=/home/alya/kahramankart-ulasim-api/data
