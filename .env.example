API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional: require this key as X-API-Key on /v1 requests.
API_ACCESS_KEY=
# Defaults to the locally captured file. Never put upstream credentials in frontend code.
# PALLIUM_AUTH_FILE=/absolute/path/to/transport-auth.json
# Or provide the complete header value, including the Basic prefix:
# PALLIUM_AUTHORIZATION=Basic ...
